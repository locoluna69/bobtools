                                                                            <Style TargetType="DataGridColumnHeader">
                                                                                <Setter Property="Background" Value="#1E293B" />
                                                                                <Setter Property="Foreground" Value="#E5E7EB" />
                                                                                <Setter Property="BorderBrush" Value="#475569" />
                                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                                <Setter Property="Padding" Value="8,6" />
                                                                            </Style>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="Background" Value="#0F172A" />
                                                                                <Setter Property="Foreground" Value="#E5E7EB" />
                                                                                <Setter Property="BorderBrush" Value="#334155" />
                                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                                                <Setter Property="Padding" Value="6,4" />
                                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter Property="Background" Value="#1D4ED8" />
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                            <Style x:Key="OfflineGridTextBlockStyle" TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#E5E7EB" />
                                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                            </Style>
                                                                            <Style x:Key="OfflineGridEditingTextBoxStyle" TargetType="TextBox">
                                                                                <Setter Property="Background" Value="#0F172A" />
                                                                                <Setter Property="Foreground" Value="#E5E7EB" />
                                                                                <Setter Property="BorderBrush" Value="#475569" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                                <Setter Property="CaretBrush" Value="#E5E7EB" />
                                                                                <Setter Property="Padding" Value="4,2" />
                                                                                <Setter Property="SelectionBrush" Value="#2563EB" />
                                                                            </Style>
                                                                        </DataGrid.Resources>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Element"
                                                                                                Binding="{Binding Element, UpdateSourceTrigger=PropertyChanged}"
                                                                                                Width="SizeToCells"
                                                                                                ElementStyle="{StaticResource OfflineGridTextBlockStyle}"
                                                                                                EditingElementStyle="{StaticResource OfflineGridEditingTextBoxStyle}" />
                                                                            <DataGridTextColumn Header="Percentage"
                                                                                                Binding="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                Width="SizeToHeader"
                                                                                                ElementStyle="{StaticResource OfflineGridTextBlockStyle}"
                                                                                                EditingElementStyle="{StaticResource OfflineGridEditingTextBoxStyle}" />
                                                                            <DataGridTextColumn Header="Quality"
                                                                                                Binding="{Binding QualityText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                Width="SizeToHeader"
                                                                                                ElementStyle="{StaticResource OfflineGridTextBlockStyle}"
                                                                                                EditingElementStyle="{StaticResource OfflineGridEditingTextBoxStyle}" />
                                                                            <DataGridTemplateColumn Header="Delete" Width="SizeToHeader">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Content="Delete"
                                                                                                Padding="6,2"
                                                                                                Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.RowSpan="3"
                    Margin="0"
                    Padding="12"
                    CornerRadius="18"
                    Background="#C90B213A"
                    BorderBrush="#667DD3FC"
                    BorderThickness="1.2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="#C90B213A" />
                        <Setter Property="BorderBrush" Value="#667DD3FC" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScanningMode}" Value="True">
                                <Setter Property="Background" Value="#C90B213A" />
                                <Setter Property="BorderBrush" Value="#7B7DD3FC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMiningMode}" Value="True">
                                <Setter Property="Background" Value="#C908221C" />
                                <Setter Property="BorderBrush" Value="#7B5DE2C1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding CompactModeScale}"
                                        ScaleY="{Binding CompactModeScale}" />
                    </Grid.LayoutTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Border Padding="12,4"
                                        Margin="0,0,8,6"
                                        CornerRadius="999"
                                        MinWidth="74"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0C4A6E" />
                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMiningMode}" Value="True">
                                                    <Setter Property="Background" Value="#0B5348" />
                                                    <Setter Property="BorderBrush" Value="#5EEAD4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="White"
                                               HorizontalAlignment="Center"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Text="{Binding CompactModeBadgeLabel}" />
                                </Border>
                                <TextBlock Margin="0,0,0,6"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Text="BobTools" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Width="28" Height="28" Margin="0,0,8,0" Click="MinimizeButton_Click" Content="—"
                                    Background="#334155" Foreground="White" BorderBrush="#475569" />
                            <Button Width="28" Height="28" Click="CloseButton_Click" Content="✕"
                                    Background="#7F1D1D" Foreground="White" BorderBrush="#991B1B" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,14,0,14">
                        <Button Style="{StaticResource CompactSelectAreaButtonStyle}"
                                Command="{Binding SelectActiveRegionCommand}"
                                ToolTip="{Binding ActiveRegionButtonLabel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="24" Height="24">
                                        <Rectangle Width="16" Height="16" Stroke="#D8F3FF" StrokeThickness="1.2" StrokeDashArray="1.4,1.1" Opacity="0.85" />
                                        <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,8 L2,2 L8,2 M16,2 L22,2 L22,8 M22,16 L22,22 L16,22 M8,22 L2,22 L2,16" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Set Area" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CompactCaptureButtonStyle}"
                                Command="{Binding CaptureActiveModeCommand}"
                                ToolTip="{Binding ActiveCaptureButtonLabel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="24" Height="24">
                                        <Path Fill="#ECFDF5" Data="M7,5 L10,5 L11.5,3.5 L16.5,3.5 L18,5 L20,5 C21.1,5 22,5.9 22,7 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 L2,7 C2,5.9 2.9,5 4,5 Z" Opacity="0.95" />
                                        <Ellipse Width="7.2" Height="7.2" Stroke="#0B3B2E" StrokeThickness="1.6" Fill="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="2.1" Height="2.1" Fill="#0B3B2E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,5.2,0" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Capture" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CompactModeSwitchButtonStyle}"
                                Command="{Binding ToggleCompactWorkflowModeCommand}"
                                ToolTip="{Binding CompactWorkflowToggleLabel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="24" Height="24">
                                        <Path Fill="#FEF3C7" Data="M6,6 L14,6 L11.6,3.6 L13.4,1.8 L18.8,7.2 L13.4,12.6 L11.6,10.8 L14,8.4 L6,8.4 Z" />
                                        <Path Fill="#FCD34D" Data="M18,18 L10,18 L12.4,20.4 L10.6,22.2 L5.2,16.8 L10.6,11.4 L12.4,13.2 L10,15.6 L18,15.6 Z" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Mode" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CompactViewToggleButtonStyle}"
                                Margin="0,0,0,10"
                                Command="{Binding ToggleCompactModeCommand}"
                                ToolTip="{Binding CompactModeToggleLabel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="24" Height="24">
                                        <Rectangle Width="18" Height="12" RadiusX="1.6" RadiusY="1.6" Stroke="#E0E7FF" StrokeThickness="1.5" />
                                        <Rectangle Width="9" Height="10" RadiusX="1.2" RadiusY="1.2" Stroke="#C7D2FE" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Overlay" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CompactSettingsButtonStyle}"
                                Margin="0,0,0,10"
                                Click="OpenSettingsButton_Click"
                                ToolTip="Open overlay settings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Width="8" Height="8" Fill="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="17" Height="17" Stroke="#E2E8F0" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path Stroke="#E2E8F0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1.8 L12,4.4 M12,19.6 L12,22.2 M1.8,12 L4.4,12 M19.6,12 L22.2,12 M4.7,4.7 L6.5,6.5 M17.5,17.5 L19.3,19.3 M17.5,6.5 L19.3,4.7 M4.7,19.3 L6.5,17.5" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Settings" />
                            </Grid>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningMode}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <TextBlock Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Text="No scan captures yet. Set the scan area, then fire a capture to populate the compact row.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatestLiveScanResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Padding="14"
                                CornerRadius="14"
                                Background="#101827"
                                BorderBrush="#1D4ED8"
                                BorderThickness="1.2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatestLiveScanResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Foreground="#BFDBFE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="Recent signatures"
                                           TextWrapping="Wrap" />
                                <ScrollViewer Margin="0,8,0,0"
                                              MaxHeight="84"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding LiveScanResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CompactListIsValid}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding CompactListSignature}" />
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="12"
                                                               Text="{Binding CompactListResource}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#BFDBFE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CompactListResourceIsHighlighted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FCD34D" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMiningMode}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <TextBlock Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Text="No mining captures yet. Set the mining area, then grab a rock to populate the compact row.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatestLiveMiningResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Padding="14"
                                CornerRadius="14"
                                Background="#0F1F1B"
                                BorderBrush="#0F766E"
                                BorderThickness="1.2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatestLiveMiningResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Text="{Binding LatestLiveMiningResult.CompactHeadline}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LatestLiveMiningResult.CompactHeadlineIsHighlighted}" Value="True">
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#CCFBF1"
                                           FontSize="11"
                                           Text="{Binding LatestLiveMiningResult.CompactMetricsSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#7DD3FC"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="Ore mix"
                                           TextWrapping="Wrap" />
                                <ItemsControl Margin="0,4,0,0"
                                              ItemsSource="{Binding LatestLiveMiningResult.CompactOreItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6"
                                                    Padding="6,3"
                                                    CornerRadius="999"
                                                    Background="#052E2B"
                                                    BorderBrush="#0F766E"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#052E2B" />
                                                        <Setter Property="BorderBrush" Value="#0F766E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter Property="Background" Value="#3F3A2200" />
                                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10"
                                                           Foreground="#D1FAE5"
                                                           Text="{Binding DisplayText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           Text="Highest quality ore is accented when quality values are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LatestLiveMiningResult.HasCompactOreItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="#8A0F172A" BorderBrush="#334155" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Status}" Foreground="#E5E7EB" />
                    <TextBlock Grid.Column="2" Foreground="#94A3B8" Text="{Binding LiveFooterSummary}" />
                    <TextBlock Grid.Column="4" Foreground="#94A3B8" Text="{Binding LastUsedOcrMode}" />
                    <TextBlock Grid.Column="6" Foreground="{Binding LastOcrSourceBrush}" Text="{Binding LastOcrSourceSummary}" />
                    <TextBlock Grid.Column="8" Foreground="#94A3B8" Text="{Binding HotkeyTargetSummary}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
