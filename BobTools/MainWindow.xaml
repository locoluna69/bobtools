<Window x:Class="BobTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BobTools"
        Height="620" Width="1460"
        MinHeight="420" MinWidth="980"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="{Binding OverlayOpacity}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Border x:Name="RootBorder"
            Margin="8"
            CornerRadius="12"
            Background="#B3111827"
            BorderBrush="#9938BDF8"
            BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <Image Width="92"
                                      Height="92"
                                      Margin="0,0,8,0"
                               Stretch="Uniform"
                               Source="pack://siteoforigin:,,,/Assets/images/BOBSL_logo_blue.png" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="BobTools" />
                            <TextBlock Margin="0,2,0,0" Foreground="#BBD5E1" Text="Top overlay — drag frame to reposition." />
                        </StackPanel>
                    </StackPanel>
                    <Border Margin="0,12,0,0"
                            Padding="12"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#3B4F67">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A30B1220" Offset="0" />
                                <GradientStop Color="#CC10233B" Offset="0.55" />
                                <GradientStop Color="#CC09131F" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Foreground="#7DD3FC"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="BOB STATS" />
                                <Border DockPanel.Dock="Right"
                                        Padding="8,3"
                                        CornerRadius="999"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1">
                                    <TextBlock Foreground="#CBD5E1"
                                               FontSize="10"
                                               Text="lifetime totals" />
                                </Border>
                            </DockPanel>

                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Text="Your Industrial Symphony" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="10"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="#1D4ED8"
                                        Background="#66121C2C"
                                        ToolTip="Total completed scan/signature OCR results across all sessions.">
                                    <StackPanel>
                                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" HorizontalAlignment="Stretch" />
                                        <TextBlock Margin="0,8,0,0" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold" Text="SIGNATURES" />
                                        <TextBlock Margin="0,4,0,0" Foreground="White" FontSize="24" FontWeight="Bold" Text="{Binding LifetimeSignatureCount}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="#94A3B8" FontSize="10" Text="Completed scan reads" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="10"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="#0F766E"
                                        Background="#6611221F"
                                        ToolTip="Total completed mining scans with meaningful rock data across all sessions.">
                                    <StackPanel>
                                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#2DD4BF" HorizontalAlignment="Stretch" />
                                        <TextBlock Margin="0,8,0,0" Foreground="#99F6E4" FontSize="11" FontWeight="SemiBold" Text="ROCKS" />
                                        <TextBlock Margin="0,4,0,0" Foreground="White" FontSize="24" FontWeight="Bold" Text="{Binding LifetimeRockCount}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="#94A3B8" FontSize="10" Text="Parsed mining finds" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4"
                                        Padding="10"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="#B45309"
                                        Background="#6623130B"
                                        ToolTip="Total ore entries found with quality greater than or equal to 900 across all sessions.">
                                    <StackPanel>
                                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#F59E0B" HorizontalAlignment="Stretch" />
                                        <TextBlock Margin="0,8,0,0" Foreground="#FCD34D" FontSize="11" FontWeight="SemiBold" Text="HIGH QUALITY" />
                                        <TextBlock Margin="0,4,0,0" Foreground="White" FontSize="24" FontWeight="Bold" Text="{Binding LifetimeHighValueOreCount}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="#94A3B8" FontSize="10" Text="Ore entries at 900+" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Padding="10" CornerRadius="8" Background="#8A0F172A" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="170"
                                Padding="10"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="#1D4ED8"
                                Background="#66121C2C">
                            <StackPanel>
                                <Rectangle Height="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Fill="#38BDF8"
                                           HorizontalAlignment="Stretch" />
                                <TextBlock Margin="0,8,0,0"
                                           FontWeight="Bold"
                                           Foreground="#93C5FD"
                                           FontSize="11"
                                           Text="RSI PROFILE" />
                                <Border Width="92"
                                        Height="92"
                                        Margin="0,12,0,0"
                                        CornerRadius="10"
                                        BorderBrush="#3B4F67"
                                        BorderThickness="1"
                                        ToolTip="Public RSI citizen avatar for the handle below.">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CC10233B" Offset="0" />
                                            <GradientStop Color="#CC09131F" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Image Source="{Binding SessionProfileImage}"
                                               Stretch="UniformToFill" />
                                        <TextBlock Margin="8"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SessionProfileImageStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SessionProfileImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBox Width="170"
                                         Height="30"
                                         Margin="0,10,0,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter the public RSI handle, for example Tater_McQuantum."
                                         Text="{Binding SessionRsiHandle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           Text="Enter the player's public RSI handle to load their citizen avatar."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource FullSelectAreaButtonStyle}"
                                        ToolTip="Set Scan area"
                                        Command="{Binding SelectSignatureRegionCommand}"
                                        Visibility="{Binding IsScanningMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Width="16" Height="16" Stroke="#D8F3FF" StrokeThickness="1.2" StrokeDashArray="1.4,1.1" Opacity="0.85" />
                                                <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,8 L2,2 L8,2 M16,2 L22,2 L22,8 M22,16 L22,22 L16,22 M8,22 L2,22 L2,16" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Set Area" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullCaptureButtonStyle}"
                                        ToolTip="Capture Scan"
                                        Command="{Binding CaptureSignatureCommand}"
                                        Visibility="{Binding IsScanningMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Path Fill="#ECFDF5" Data="M7,5 L10,5 L11.5,3.5 L16.5,3.5 L18,5 L20,5 C21.1,5 22,5.9 22,7 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 L2,7 C2,5.9 2.9,5 4,5 Z" Opacity="0.95" />
                                                <Ellipse Width="7.2" Height="7.2" Stroke="#0B3B2E" StrokeThickness="1.6" Fill="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse Width="2.1" Height="2.1" Fill="#0B3B2E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,5.2,0" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Capture" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullSelectAreaButtonStyle}"
                                        ToolTip="Set Mining area"
                                        Command="{Binding SelectMiningRegionCommand}"
                                        Visibility="{Binding IsMiningMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Width="17" Height="12" RadiusX="2" RadiusY="2" Stroke="#ECFEFF" StrokeThickness="1.4" Fill="#103540" />
                                                <Path Fill="#67E8F9" Data="M6,17 L9.5,12.6 L12.2,15.6 L15.1,10.5 L18,17 Z" />
                                                <Ellipse Width="3.2" Height="3.2" Fill="#A5F3FC" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.5,5.5,0,0" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Set Area" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullCaptureButtonStyle}"
                                        ToolTip="Capture Mining"
                                        Command="{Binding CaptureMiningCommand}"
                                        Visibility="{Binding IsMiningMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Path Fill="#ECFDF5" Data="M4,17 L9.6,7 L15.4,17 Z" />
                                                <Path Fill="#6EE7B7" Data="M9.2,17 L13.8,8.8 L18.7,17 Z" />
                                                <Ellipse Width="3" Height="3" Fill="#D1FAE5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3.4" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Capture" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullModeActionButtonStyle}"
                                        ToolTip="Queue Folder"
                                        Command="{Binding LoadLiveMiningFolderCommand}"
                                        Visibility="{Binding IsOfflineMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Path Fill="#FDE68A" Data="M3,7 C3,5.9 3.9,5 5,5 L9.2,5 L11.2,7 L19,7 C20.1,7 21,7.9 21,9 L21,17 C21,18.1 20.1,19 19,19 L5,19 C3.9,19 3,18.1 3,17 Z" />
                                                <Path Fill="#FBBF24" Data="M4,10 L20,10 L18.2,18 L5.8,18 Z" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Queue" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullViewToggleButtonStyle}"
                                        ToolTip="Compact Mode"
                                        Command="{Binding ToggleCompactModeCommand}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Width="18" Height="12" RadiusX="1.6" RadiusY="1.6" Stroke="#E0E7FF" StrokeThickness="1.5" />
                                                <Rectangle Width="9" Height="10" RadiusX="1.2" RadiusY="1.2" Stroke="#C7D2FE" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Compact" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FullSettingsButtonStyle}"
                                        ToolTip="Open overlay settings"
                                        Click="OpenSettingsButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Width="8" Height="8" Fill="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse Width="17" Height="17" Stroke="#E2E8F0" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Path Stroke="#E2E8F0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1.8 L12,4.4 M12,19.6 L12,22.2 M1.8,12 L4.4,12 M19.6,12 L22.2,12 M4.7,4.7 L6.5,6.5 M17.5,17.5 L19.3,19.3 M17.5,6.5 L19.3,4.7 M4.7,19.3 L6.5,17.5" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" Text="Settings" />
                                    </Grid>
                                </Button>
                            </WrapPanel>

                            <WrapPanel VerticalAlignment="Center">
                                <ComboBox Width="170" Height="30" Margin="0,0,10,0"
                                          ToolTip="Choose the current workflow: live scanning, live mining, or offline queue processing."
                                          ItemsSource="{Binding WorkflowModeOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedWorkflowMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOfflineMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ToggleButton x:Name="TopScanTargetSelectorButton"
                                                  Width="240"
                                                  Height="30"
                                                  HorizontalAlignment="Left"
                                                  Padding="10,6"
                                                  Background="#0F172A"
                                                  BorderBrush="#475569"
                                                  Foreground="#E5E7EB"
                                                  ToolTip="Checked resources are highlighted in the live queue when OCR matches them."
                                                  IsChecked="{Binding IsScanTargetSelectorOpen, Mode=TwoWay}"
                                                  Content="{Binding SelectedScanTargetsSummary}" />
                                    <Popup PlacementTarget="{Binding ElementName=TopScanTargetSelectorButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           IsOpen="{Binding IsScanTargetSelectorOpen, Mode=TwoWay}">
                                        <Border Margin="0,6,0,0"
                                                Padding="12"
                                                Width="320"
                                                MaxHeight="320"
                                                CornerRadius="10"
                                                Background="#E6111827"
                                                BorderBrush="#F59E0B"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="Highlight matching scan resources" />
                                                <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                                                    <Button Width="80" Margin="0,0,8,0" Content="Select All" Command="{Binding SelectAllScanTargetsCommand}" />
                                                    <Button Width="80" Content="Clear" Command="{Binding ClearScanTargetsCommand}" />
                                                </WrapPanel>
                                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ScanTargetOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Margin="0,0,0,6"
                                                                          Foreground="#E5E7EB"
                                                                          Content="{Binding Resource}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanningMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMiningMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOfflineMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="Session Context" />
                                <WrapPanel Margin="0,6,0,0" ItemHeight="30">
                                    <ComboBox Width="170"
                                              Height="30"
                                              Margin="0,0,10,0"
                                                             ItemsSource="{Binding SessionShipOptions}"
                                                             SelectedItem="{Binding SelectedSessionShip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Width="130"
                                              Height="30"
                                              Margin="0,0,10,0"
                                                             ItemsSource="{Binding SessionSystemOptions}"
                                                             SelectedItem="{Binding SelectedSessionSystem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox Width="540"
                                              Height="30"
                                                          Style="{StaticResource SearchableComboBoxStyle}"
                                                                                                                         ToolTip="Type to filter by system, planet, moon, orbit, station, or nickname."
                                                             IsEditable="True"
                                                             IsTextSearchEnabled="False"
                                                             StaysOpenOnEdit="True"
                                                             ItemsSource="{Binding SessionLocationOptions}"
                                                             SelectedItem="{Binding SelectedSessionLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Text="{Binding SessionLocationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayPath" />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#93C5FD"
                                                         Text="{Binding SessionContextSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Width="34" Height="28" Margin="0,0,8,0" Click="MinimizeButton_Click" Content="—"
                            Background="#334155" Foreground="White" BorderBrush="#475569" />
                    <Button Width="34" Height="28" Margin="0,0,8,0" Click="ToggleMaximizeButton_Click" Content="□"
                        Background="#334155" Foreground="White" BorderBrush="#475569" />
                    <Button Width="34" Height="28" Click="CloseButton_Click" Content="✕"
                            Background="#7F1D1D" Foreground="White" BorderBrush="#991B1B" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,10,0,0" Background="#6B0F172A" BorderBrush="#334155" Foreground="White"
                        SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabItem Header="Live Results">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanningMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMiningMode}" Value="True">
