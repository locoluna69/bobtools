                                                 ItemsSource="{Binding OfflineScanResults}"
                                                 SelectedItem="{Binding SelectedOfflineScanResult}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#E5E7EB"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10"
                                                            CornerRadius="10"
                                                            BorderThickness="1"
                                                            Background="#66121C2C"
                                                            BorderBrush="#334155">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#334155" />
                                                                <Setter Property="Background" Value="#66121C2C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                                                        <Setter Property="Background" Value="#7A10233B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsTargetMatch}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Foreground="White"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Foreground="#A7F3D0"
                                                                           Text="{Binding SignatureResourceSummary}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Foreground="#94A3B8"
                                                                           FontSize="11"
                                                                           Text="{Binding ProcessingState}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    Padding="8,4"
                                                                    CornerRadius="999"
                                                                    Background="#1E293B"
                                                                    BorderBrush="#334155"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Top">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Grid Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <Ellipse Stroke="#7DD3FC" StrokeThickness="1" />
                                                                        <Ellipse Width="5" Height="5" Stroke="#7DD3FC" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Ellipse Width="2" Height="2" Fill="#BAE6FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <TextBlock Foreground="#CBD5E1"
                                                                               FontSize="10"
                                                                               VerticalAlignment="Center"
                                                                               Text="scan" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Processed Image" Foreground="White" BorderBrush="#475569">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Foreground="#94A3B8" VerticalAlignment="Center" Text="{Binding SelectedOfflineScanResult.ImageZoomLabel}" />
                                            <Slider Margin="10,0,0,0"
                                                    Minimum="0.5"
                                                    Maximum="4"
                                                    TickFrequency="0.25"
                                                    IsSnapToTickEnabled="False"
                                                    Value="{Binding SelectedOfflineScanResult.ImageZoom, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                                            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <Image Source="{Binding SelectedOfflineScanResult.ProcessedPreviewImage}" Stretch="Uniform">
                                                    <Image.LayoutTransform>
                                                        <ScaleTransform ScaleX="{Binding SelectedOfflineScanResult.ImageZoom}" ScaleY="{Binding SelectedOfflineScanResult.ImageZoom}" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Column="2" Header="Scan Review" Foreground="White" BorderBrush="#475569">
                                    <ScrollViewer Margin="6" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Border Padding="10" CornerRadius="6" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="State" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SelectedOfflineScanResult.ProcessingState}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Text="Resource" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedOfflineScanResult.SignatureResourceSummary}" Foreground="#A7F3D0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2" Text="Target" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedOfflineScanResult.TargetAlertSummary}" Foreground="#FCA5A5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="3" Text="OCR Mode" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedOfflineScanResult.UsedOcrModeSummary}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="4" Text="Source" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedOfflineScanResult.OcrSourceSummary}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="5" Text="Selection" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedOfflineScanResult.SelectionModeSummary}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Margin="0,10,0,6" Text="OCR Text" Foreground="#94A3B8" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding SelectedOfflineScanResult.OcrText}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     IsReadOnly="True"
                                                     MinHeight="220"
                                                     Background="#0F172A"
                                                     Foreground="#E5E7EB"
                                                     BorderBrush="#334155" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOfflineMiningSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding OfflineMiningRockSummary}" />
                            <Border Grid.Row="2"
                                    Padding="8"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="#3B4F67"
                                    Background="#330B1220">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                            <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                <Polygon Points="7,0.8 13.2,7 7,13.2 0.8,7"
                                                         Fill="#0F172A"
                                                         Stroke="#FBBF24"
                                                         StrokeThickness="1.2" />
                                                <Ellipse Width="3" Height="3" Fill="#FDE68A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Foreground="#93C5FD"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Text="MINING REVIEWS" />
                                    </StackPanel>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding OfflineMiningResults}"
                                             SelectedItem="{Binding SelectedOfflineMiningResult}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#E5E7EB"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,10" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12"
                                                            CornerRadius="12"
                                                            BorderThickness="1"
                                                            Background="#66121C2C"
                                                            BorderBrush="#334155">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#334155" />
                                                                <Setter Property="Background" Value="#66121C2C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                                                        <Setter Property="Background" Value="#7A10233B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Foreground="White"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding DisplayName}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,3,0,0"
                                                                               Foreground="#A7F3D0"
                                                                               Text="{Binding Summary}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,3,0,0"
                                                                               Foreground="#94A3B8"
                                                                               FontSize="11"
                                                                               Text="{Binding ProcessingState}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Margin="10,0,0,0"
                                                                        Padding="8,4"
                                                                        CornerRadius="999"
                                                                        Background="#1E293B"
                                                                        BorderBrush="#334155"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Top">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Grid Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <Polygon Points="5,0.7 9.3,5 5,9.3 0.7,5"
                                                                                     Fill="#0F172A"
                                                                                     Stroke="#FBBF24"
                                                                                     StrokeThickness="1" />
                                                                            <Ellipse Width="2" Height="2" Fill="#FDE68A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <TextBlock FontSize="10"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="mine" />
                                                                                    <Setter Property="Foreground" Value="#CBD5E1" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                                            <Setter Property="Text" Value="pending" />
                                                                                            <Setter Property="Foreground" Value="#FCD34D" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <Grid Margin="0,12,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="260" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock DockPanel.Dock="Left" Foreground="#94A3B8" VerticalAlignment="Center" Text="{Binding ImageZoomLabel}" />
                                                                        <Slider Margin="10,0,0,0"
                                                                                Minimum="0.5"
                                                                                Maximum="4"
                                                                                TickFrequency="0.25"
                                                                                IsSnapToTickEnabled="False"
                                                                                Value="{Binding ImageZoom, Mode=TwoWay}"
                                                                                VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                    <Border Background="#0F172A"
                                                                            BorderBrush="#334155"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Height="170">
                                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                            <Image Source="{Binding DisplayPreviewImage}" Stretch="Uniform">
                                                                                <Image.LayoutTransform>
                                                                                    <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                                                                </Image.LayoutTransform>
                                                                            </Image>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                    <Grid Margin="0,10,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="OCR Mode" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding UsedOcrModeSummary}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Row="1" Text="Source" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OcrSourceSummary}" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2">
                                                                    <Border Padding="10"
                                                                            CornerRadius="8"
                                                                            Background="#0F172A"
                                                                            BorderBrush="#334155"
                                                                            BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="24" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
