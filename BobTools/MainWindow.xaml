                                                                            <TextBlock Grid.Column="4" Text="Resistance" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Column="6" Text="{Binding EditableResistance, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#334155" />
                                                                            <TextBlock Grid.Row="1" Text="Material" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EditableMaterial, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#334155" />
                                                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Instability" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding EditableInstability, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#334155" />
                                                                            <TextBlock Grid.Row="2" Text="Mass" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding EditableMass, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#334155" />
                                                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Composition" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding EditableComposition, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#334155" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <WrapPanel Margin="0,10,0,8">
                                                                        <Button Content="Add Row" Width="100" Margin="0,0,8,0" Command="{Binding AddRowCommand}" />
                                                                        <Button Content="Save Result"
                                                                                Width="110"
                                                                                Command="{Binding SaveCommand}"
                                                                                Style="{StaticResource DirtyAwareSaveButtonStyle}"
                                                                                Tag="{Binding IsDirty}" />
                                                                    </WrapPanel>

                                                                    <DataGrid ItemsSource="{Binding EditableElements}"
                                                                              AutoGenerateColumns="False"
                                                                              CanUserAddRows="False"
                                                                              HeadersVisibility="Column"
                                                                              Background="#0F172A"
                                                                              Foreground="#E5E7EB"
                                                                              BorderBrush="#334155"
                                                                              RowBackground="#0F172A"
                                                                              AlternatingRowBackground="#111827"
                                                                              GridLinesVisibility="Horizontal"
                                                                              HorizontalGridLinesBrush="#334155"
                                                                              VerticalGridLinesBrush="#334155"
                                                                              MinHeight="180">
