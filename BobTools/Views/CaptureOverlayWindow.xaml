<Window x:Class="BobTools.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False">
    <Grid IsHitTestVisible="False">
        <Border BorderBrush="{StaticResource OverlayAccentBrushTheme}"
                BorderThickness="3"
                CornerRadius="4"
                Background="#1A00B7FF" />
        <Grid x:Name="SignatureGuide" Visibility="Collapsed" Margin="14">
            <Rectangle Stroke="#CCFFFFFF"
                       StrokeThickness="1.5"
                       StrokeDashArray="4 3"
                       RadiusX="2"
                       RadiusY="2" />
            <Rectangle Height="1"
                       Fill="#B3FFFFFF"
                       VerticalAlignment="Center"
                       Margin="10,0" />
            <Rectangle Width="1"
                       Fill="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,10" />
        </Grid>
    </Grid>
</Window>