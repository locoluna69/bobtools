<Window x:Class="BobTools.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Capture Region"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        ShowInTaskbar="False">
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp">
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="{StaticResource OverlayAccentBrushTheme}"
                   Fill="#2200B7FF"
                   StrokeThickness="2"
                   Visibility="Collapsed" />
        <Border Canvas.Left="20" Canvas.Top="20"
                Background="#E6111827"
                BorderBrush="#9938BDF8"
                BorderThickness="1"
                Padding="12"
                CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="InstructionTitleTextBlock" Foreground="White" FontSize="18" FontWeight="Bold" Text="Drag inside the Star Citizen window" />
                <TextBlock x:Name="InstructionBodyTextBlock" Foreground="{StaticResource MutedForegroundBrushTheme}" Margin="0,6,0,0" Text="Release mouse to save a region relative to Star Citizen, or press Esc to cancel." TextWrapping="Wrap" Width="360" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
