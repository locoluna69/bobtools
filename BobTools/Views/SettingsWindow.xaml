<Window x:Class="BobTools.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Settings"
        Width="760"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="10"
            Padding="18"
            CornerRadius="16"
            Background="#EE111827"
            BorderBrush="#7B38BDF8"
            BorderThickness="1.2"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="Overlay Settings" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#94A3B8"
                               Text="Move overlay behavior, hotkey, and transparency controls out of the main surface." />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Content="✕"
                        Background="#7F1D1D"
                        BorderBrush="#991B1B"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14"
                        CornerRadius="14"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#40111F33">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" Text="Capture And Overlay" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#94A3B8"
                                   Text="Controls that affect what gets saved and how visible the overlay stays in-game."
                                   TextWrapping="Wrap" />

                        <CheckBox Margin="0,14,0,0"
                                  Foreground="White"
                                  Content="Capture only"
                                  ToolTip="Save the raw screenshot without running OCR. Raw captures go to LocalAppData/BobTools/raw-captures-scan or raw-captures-mine."
                                  IsChecked="{Binding CaptureOnlyMode}" />
                        <CheckBox Margin="0,10,0,0"
                                  Foreground="White"
                                  Content="Save debug"
                                  ToolTip="Save intermediate debug artifacts and processed images under LocalAppData/BobTools/DebugCaptures."
                                  IsChecked="{Binding SaveDebugImages}" />

                        <Button Width="160"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Content="Open Debug Folder"
                                Command="{Binding OpenDebugFolderCommand}" />

                        <StackPanel Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanningMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="Training Export" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Text="Package the current live-scan session into a zip for recognizer training review."
                                       TextWrapping="Wrap" />
                            <Button Width="160"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Export Training Zip"
                                    Command="{Binding ExportScanTrainingPackageCommand}" />
                        </StackPanel>

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                CornerRadius="12"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Background="#330B1220">
                            <StackPanel>
                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="Transparency" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Text="Lower values make the overlay less intrusive, but they also make text and controls harder to read."
                                           TextWrapping="Wrap" />
                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Foreground="#93C5FD"
                                               FontWeight="SemiBold"
                                               Text="Overlay opacity" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" />
                                </DockPanel>
                                <Slider Margin="0,10,0,0"
                                        Minimum="0.45"
                                        Maximum="1.0"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="12"
                                CornerRadius="12"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Background="#330B1220">
                            <StackPanel>
                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="Compact Scale" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Text="Scale the compact overlay for different monitor sizes and resolutions. Changes apply immediately while compact mode is open."
                                           TextWrapping="Wrap" />
                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Foreground="#93C5FD"
                                               FontWeight="SemiBold"
                                               Text="Compact overlay size" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               Text="{Binding CompactModeScale, StringFormat={}{0:P0}}" />
                                </DockPanel>
                                <Slider Margin="0,10,0,0"
                                        Minimum="0.4"
                                        Maximum="1.25"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding CompactModeScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,0"
                                   Foreground="#CBD5E1"
                                   FontSize="11"
                                   Text="{Binding OverlaySettingsSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Padding="14"
                        CornerRadius="14"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#40111F33">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" Text="Global Hotkey" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#94A3B8"
                                   Text="Use a chord that Star Citizen is unlikely to consume. Function keys with modifiers remain the safest default."
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,14,0,0">
                            <ComboBox Width="180"
                                      Height="30"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding HotkeyModifierOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedHotkeyModifiers}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Width="130"
                                      Height="30"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding HotkeyKeyOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedHotkeyVirtualKey}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </WrapPanel>

                        <WrapPanel>
                            <Button Margin="0,0,10,10"
                                    Content="Use Recommended"
                                    Command="{Binding ApplyRecommendedHotkeyCommand}" />
                            <Button Margin="0,0,0,10"
                                    Content="{Binding HotkeyRecorderButtonLabel}"
                                    Command="{Binding ToggleHotkeyRecordingCommand}" />
                        </WrapPanel>

                        <TextBlock Foreground="#93C5FD"
                                   FontWeight="SemiBold"
                                   Text="{Binding ConfiguredHotkeySummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#BFDBFE"
                                   Text="{Binding RecommendedHotkeySummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#E5E7EB"
                                   Text="{Binding HotkeyRecorderSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#94A3B8"
                                   Text="{Binding HotkeyRegistrationStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <DockPanel Grid.Row="4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"
                           Text="Changes save immediately and apply to the live overlay." />
                <Button DockPanel.Dock="Right"
                        MinWidth="110"
                        Content="Close"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>