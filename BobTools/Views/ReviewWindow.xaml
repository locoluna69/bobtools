<Window x:Class="BobTools.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review OCR Result"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Margin="10"
            Padding="14"
            CornerRadius="12"
            Background="#E6111827"
            BorderBrush="#9938BDF8"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Review OCR Result"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="Edit the extracted text, then accept it."
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedForegroundBrushTheme}" />
                <TextBlock x:Name="ResourceSummaryTextBlock"
                           Margin="0,8,0,0"
                           Foreground="#A7F3D0"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBox x:Name="EditorTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" />

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Accept" Width="100" Margin="0,0,8,0" Click="Accept_Click" />
                <Button Content="Cancel" Width="100" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
