<Application x:Class="BobTools.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderBrushTheme" Color="#475569" />
        <SolidColorBrush x:Key="ForegroundBrushTheme" Color="#E5E7EB" />
        <SolidColorBrush x:Key="MutedForegroundBrushTheme" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrushTheme" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrushTheme" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrushTheme" Color="#1E40AF" />
        <SolidColorBrush x:Key="ImageButtonBrushTheme" Color="#162033" />
        <SolidColorBrush x:Key="ImageButtonHoverBrushTheme" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ImageButtonPressedBrushTheme" Color="#1E3A8A" />
        <SolidColorBrush x:Key="SaveDirtyBrushTheme" Color="#B45309" />
        <SolidColorBrush x:Key="SaveDirtyBorderBrushTheme" Color="#F59E0B" />
        <SolidColorBrush x:Key="WindowChromeBrushTheme" Color="#111827" />
        <SolidColorBrush x:Key="OverlayAccentBrushTheme" Color="#00B7FF" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrushTheme}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrushTheme}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource ImageButtonBrushTheme}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ImageButtonHoverBrushTheme}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ImageButtonPressedBrushTheme}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#133C63" Offset="0" />
                        <GradientStop Color="#0D2E4E" Offset="0.52" />
                        <GradientStop Color="#082038" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    CornerRadius="16"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Color="#66000000"
                                                      Opacity="0.55" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="InnerSheen"
                                    Margin="1"
                                    CornerRadius="15"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    Opacity="0.85">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                                        <GradientStop Color="#10000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border x:Name="HoverOverlay"
                                    Margin="1"
                                    CornerRadius="15"
                                    Background="#30FFFFFF"
                                    Opacity="0" />

                            <ContentPresenter x:Name="ContentHost"
                                              Margin="12,8"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.16" />
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.24" />
                                <Setter TargetName="ContentHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.96" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.42" />
                                <Setter TargetName="InnerSheen" Property="Opacity" Value="0.2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSelectAreaButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#164E8A" Offset="0" />
                        <GradientStop Color="#123E6F" Offset="0.52" />
                        <GradientStop Color="#0B284A" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#7DD3FC" />
        </Style>

        <Style x:Key="CompactCaptureButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0E5C49" Offset="0" />
                        <GradientStop Color="#0B483A" Offset="0.52" />
                        <GradientStop Color="#073026" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#6EE7B7" />
        </Style>

        <Style x:Key="CompactModeSwitchButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3E0A" Offset="0" />
                        <GradientStop Color="#5F2E08" Offset="0.52" />
                        <GradientStop Color="#412006" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FBBF24" />
        </Style>

        <Style x:Key="CompactViewToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4338CA" Offset="0" />
                        <GradientStop Color="#312E81" Offset="0.52" />
                        <GradientStop Color="#1E1B4B" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#A5B4FC" />
        </Style>

        <Style x:Key="CompactSettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B2447" Offset="0" />
                        <GradientStop Color="#431B34" Offset="0.52" />
                        <GradientStop Color="#2C1122" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#F9A8D4" />
        </Style>

        <Style x:Key="OverlayToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FullSelectAreaButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactSelectAreaButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FullCaptureButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactCaptureButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FullModeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactModeSwitchButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FullViewToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactViewToggleButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FullSettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactSettingsButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="82" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrushTheme}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <Border x:Name="ComboBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Margin="10,0,6,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          RecognizesAccessKey="True" />

                                        <Border Grid.Column="1"
                                                Background="{StaticResource PanelAltBrush}"
                                                BorderBrush="{StaticResource BorderBrushTheme}"
                                                BorderThickness="1,0,0,0"
                                                CornerRadius="0,6,6,0">
                                            <Path Width="10"
                                                  Height="6"
                                                  Stretch="Fill"
                                                  Fill="{StaticResource ForegroundBrushTheme}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 10 0 L 5 6 Z" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushTheme}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="260"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger SourceName="ToggleButton" Property="IsChecked" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="SelectionContent"
                                                      Grid.Column="0"
                                                      Margin="10,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      RecognizesAccessKey="True" />

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="8,2,4,2"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{TemplateBinding Foreground}"
                                             Visibility="Collapsed"
                                             Focusable="True"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />

                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="{StaticResource PanelAltBrush}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  BorderBrush="{StaticResource BorderBrushTheme}"
                                                  BorderThickness="1,0,0,0">
                                        <Path Width="10"
                                              Height="6"
                                              Stretch="Fill"
                                              Fill="{StaticResource ForegroundBrushTheme}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 10 0 L 5 6 Z" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushTheme}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer MaxHeight="260"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger SourceName="ToggleButton" Property="IsChecked" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrushTheme}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushTheme}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushTheme}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#6B0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTheme}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushTheme}"
                                    BorderThickness="1"
                                    CornerRadius="8,8,0,0"
                                    Padding="6,6,6,0">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <Border Grid.Row="1"
                                    Background="#6B0F172A"
                                    BorderBrush="{StaticResource BorderBrushTheme}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,8,8"
                                    Padding="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrushTheme}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushTheme}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrushTheme}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentHoverBrushTheme}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrushTheme}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DirtyAwareSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ToolTip" Value="Save changes." />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SaveDirtyBrushTheme}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SaveDirtyBorderBrushTheme}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="This result has unsaved edits." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
