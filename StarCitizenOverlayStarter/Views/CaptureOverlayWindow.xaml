<Window x:Class="StarCitizenOverlayStarter.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False">
    <Grid IsHitTestVisible="False">
        <Border BorderBrush="{StaticResource OverlayAccentBrushTheme}"
                BorderThickness="3"
                CornerRadius="4"
                Background="#1A00B7FF" />
    </Grid>
</Window>